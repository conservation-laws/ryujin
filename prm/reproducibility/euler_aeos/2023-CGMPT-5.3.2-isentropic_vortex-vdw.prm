##
#
# 2D isentropic vortex with the van der Waals equation of state, Section
# 5.3.2 (Table 2) of [1].
#
# Van der Waals EOS (5.2) with gamma = 3/2, a = 1, b = 0. The exact
# solution (A.2) of [1] is
#
#   rho = (3C/(4a) - 1/2 sqrt(9C^2/(4a^2) + 2/a (F + psi^2/(2 r_0^2))))^2,
#   v   = v_inf + psi (-x_2, x_1),   p = C rho^(3/2) - a rho^2,
#
# with
#
#   (x_1, x_2) = x - x_0 - v_inf t,
#   psi = beta / (2 pi) exp((1 - |x|^2 / r_0^2) / 2),
#   C   = (p_inf + a rho_inf^2) / rho_inf^(3/2) = 101 / sqrt(10),
#   F   = -a rho_inf - 3 p_inf / rho_inf = -30.1.
#
# Far field rho_inf = 0.1, p_inf = 1, v_inf = (1,1); x_0 = (-1,-1),
# r_0 = 1, beta = 20. Domain (-5,5)^2 with Dirichlet boundary conditions,
# final time T = 2, CFL 0.1, SSPRK(3,3). The exact solution is entered as a
# time-dependent "function" initial state and is used for the boundary data
# and the error evaluation.
#
# We report the consolidated error delta_q of (5.5) of [1]. Mesh refinement
# 4 corresponds to the coarsest grid of Table 2 (289 points); refinement 5,
# ..., 11 give the other rows.
#
# The computations of [1] used an activation function in the smoothness
# indicator that is no longer used in ryujin. We reduce the entropy
# viscosity commutator with "evc factor = 0.1" instead.
#
# [1] B. Clayton, J.-L. Guermond, M. Maier, B. Popov, E. J. Tovar. Robust
#     second-order approximation of the compressible Euler equations with
#     an arbitrary equation of state. J. Comput. Phys., 478:111926, 2023.
#     arXiv:2207.12832
#
##

subsection A - Scheduler
  set basename          = isentropic_vortex-vdw
  set tasks             = error evaluation
  set final time        = 2
  set timer granularity = 2
end


subsection B - Equation
  set dimension             = 2
  set equation              = euler aeos
  set equation of state     = van der waals

  subsection van der waals
    set gamma      = 1.5
    set vdw a      = 1
    set covolume b = 0
  end
end


subsection C - Discretization
  set geometry        = rectangular domain
  set mesh refinement = 4

  subsection rectangular domain
    set position bottom left      = -5, -5
    set position top right        = 5, 5
    set boundary condition left   = dirichlet
    set boundary condition right  = dirichlet
    set boundary condition bottom = dirichlet
    set boundary condition top    = dirichlet
  end
end


subsection E - InitialValues
  set configuration = function
  set direction     = 1, 0
  set position      = 0, 0

  #
  # psi = 10/pi exp((1 - (x+1-t)^2 - (y+1-t)^2)/2); 3C/(4a) =
  # 23.95425327577547 and 9C^2/(4a^2) + 2F/a = 2235.025.
  #
  subsection function
    set density expression    = \
      (23.95425327577547 - 0.5 * sqrt(2235.025 + (3.183098861837907 \
      * exp(0.5 * (1 - (x+1-t)^2 - (y+1-t)^2)))^2))^2
    set velocity x expression = \
      1 - 3.183098861837907 * exp(0.5 * (1 - (x+1-t)^2 - (y+1-t)^2)) * (y+1-t)
    set velocity y expression = \
      1 + 3.183098861837907 * exp(0.5 * (1 - (x+1-t)^2 - (y+1-t)^2)) * (x+1-t)
    set pressure expression   = \
      31.93900436770063 * ((23.95425327577547 - 0.5 * sqrt(2235.025 \
      + (3.183098861837907 * exp(0.5 * (1 - (x+1-t)^2 - (y+1-t)^2)))^2)) \
      ^2)^1.5 \
      - ((23.95425327577547 - 0.5 * sqrt(2235.025 + (3.183098861837907 \
      * exp(0.5 * (1 - (x+1-t)^2 - (y+1-t)^2)))^2))^2)^2
  end
end


subsection F - HyperbolicModule
  set limit at dirichlet boundaries = false

  subsection indicator
    set evc factor = 0.1
  end
end


subsection H - TimeIntegrator
  set cfl min               = 0.10
  set cfl max               = 0.10
  set cfl recovery strategy = none
  set time stepping scheme  = ssprk 33
end


subsection K - ErrorEvaluation
  set error normalize  = true
  set error quantities = rho, m_1, m_2, E
end
