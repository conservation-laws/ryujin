##
#
# 1D Woodward-Colella interacting blast waves [2] with the Jones-Wilkins-Lee
# equation of state, Section 5.4.1 (Figure 1, left, Table 3, Case 1) of
# [1].
#
# Initial state (rho, v, p) = (1, 0, 1e3) on [0, 0.1], (1, 0, 1e-2) on
# (0.1, 0.9), and (1, 0, 1e2) on [0.9, 1]. Domain (0,1) with slip boundary
# conditions, CFL 0.9, SSPRK(3,3). JWL EOS (5.4) with the parameters of
# Case 1 of Table 3 (Toro et al.): A = 632.1, B = -4.472, R_1 = 11.3,
# R_2 = 1.13, omega = 0.8938, rho_0 = 1. Table 3 lists A = 6.321e3, but
# only A = 632.1 reproduces Figure 1 (peak density 2.72 at x = 0.78). Final
# time T = 0.038.
#
# Note: The paper computed Figure 1 with a separate Fortran code (P1 on
# simplices); this is the corresponding ryujin configuration. The 1600
# subdivisions are the coarsest mesh of Figure 1; mesh refinement = 2 and 4
# give the 6400 and 25600 element meshes.
#
# [1] B. Clayton, J.-L. Guermond, M. Maier, B. Popov, E. J. Tovar. Robust
#     second-order approximation of the compressible Euler equations with an
#     arbitrary equation of state. J. Comput. Phys., 478:111926, 2023.
#     DOI 10.1016/j.jcp.2023.111926, arXiv:2207.12832
#
# [2] P. Woodward, P. Colella. The numerical simulation of two-dimensional
#     fluid flow with strong shocks. J. Comput. Phys., 54(1):115-173, 1984.
#     DOI 10.1016/0021-9991(84)90142-6
#
##

subsection A - Scheduler
  set basename          = blast_wave-jwl-case_1
  set tasks             = vtu output
  set final time        = 0.038
  set timer granularity = 0.038
end


subsection B - Equation
  set dimension         = 1
  set equation          = euler aeos
  set equation of state = jones wilkins lee

  subsection jones wilkins lee
    set A     = 632.1
    set B     = -4.472
    set R1    = 11.3
    set R2    = 1.13
    set omega = 0.8938
    set rho_0 = 1
    set q_0   = 0
  end
end


subsection C - Discretization
  set geometry        = rectangular domain
  set mesh refinement = 0

  subsection rectangular domain
    set position bottom left     = 0
    set position top right       = 1
    set subdivisions x           = 1600
    set boundary condition left  = slip
    set boundary condition right = slip
  end
end


subsection E - InitialValues
  set configuration = three state contrast
  set direction     = 1
  set position      = 0

  subsection three state contrast
    set left region length     = 0.1
    set middle region length   = 0.8
    set primitive state left   = 1, 0, 1e3
    set primitive state middle = 1, 0, 1e-2
    set primitive state right  = 1, 0, 1e2
  end
end


subsection H - TimeIntegrator
  set cfl min               = 0.90
  set cfl max               = 0.90
  set cfl recovery strategy = none
  set time stepping scheme  = ssprk 33
end


subsection I - VTUOutput
  subsection full
    set vtu output quantities = rho, v, p, e
  end
end
