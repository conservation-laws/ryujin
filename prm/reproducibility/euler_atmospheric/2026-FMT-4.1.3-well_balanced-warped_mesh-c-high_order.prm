##
#
# Well-balancing test on a curvilinear mesh with an isentropic (constant
# potential temperature) background state, Section 4.1.3 (Figure 4.1) of
# [1]:
#
#   theta = 300 K,  T = theta - g y / c_p,  p = p_0 (T / theta)^(c_p / R),
#   rho = p / (R T),  v = 0,
#
# in [0,1000]^2 with slip boundary conditions on all sides. The
# thermodynamic constants are c_p = 1004, c_v = 717, R = c_p - c_v = 287
# (thus gamma = c_p / c_v), p_0 = 10^5 Pa and g = 9.81.
#
# The mesh is a smooth curvilinear mapping of [-1,1]^2 onto [0,1000]^2:
#
#   x = 500 (1 + xi  + 0.1 sin(pi xi) sin(pi eta)),
#   y = 500 (1 + eta + 0.1 sin(pi xi) sin(pi eta)).
#
# The boundaries remain straight because sin(pi xi) and sin(pi eta) vanish
# at xi, eta = +-1. The final time is set to t = 5000 s.
#
# Variant (c) of Figure 4.1: full high-order method.
#
# [1] C. Farris, M. Maier, E. J. Tovar. Well-balanced second-order
#     approximation of the compressible atmospheric Euler equations.
#     arXiv:2606.19764, 2026.
#
##

subsection A - Scheduler
  set basename          = well-balanced-adiabatic-c
  set tasks             = error evaluation, vtu output
  set final time        = 5000
  set timer granularity = 50
end

subsection B - Equation
  set dimension          = 2
  set equation           = euler atmospheric
  set c_v                = 717
  set gamma              = 1.400278940027894
  set gravity            = 9.81
  set reference pressure = 100000
end

subsection C - Discretization
  set geometry              = rectangular domain
  set finite element ansatz = cG Q1
  set mesh refinement       = 0

  subsection rectangular domain
    set position bottom left      = -1, -1
    set position top right        =  1,  1
    set transformation            = 500*(1 + x + 0.1*sin(3.141592653589793*x)*sin(3.141592653589793*y)); 500*(1 + y + 0.1*sin(3.141592653589793*x)*sin(3.141592653589793*y))
    set subdivisions x            = 16
    set subdivisions y            = 16
    set boundary condition left   = slip
    set boundary condition right  = slip
    set boundary condition bottom = slip
    set boundary condition top    = slip
  end
end

subsection E - InitialValues
  set configuration = stratified
  set position      = 0, 0

  subsection stratified
    set velocity x expression = 0
    set velocity y expression = 0
    set theta expression      = 300
  end
end

subsection H - TimeIntegrator
  set cfl min               = 0.5
  set cfl max               = 0.5
  set cfl recovery strategy = none
  set tau_max               = 0.01
end

subsection I - VTUOutput
  subsection full
    set vtu output quantities = rho, v_1, v_2, theta, p
  end
end

#
# The analytic solution is the (steady) initial state, so the error is the
# deviation from the hydrostatic balance. Note that the reported value is
# the sum over all error quantities: set the error quantities to either v_1
# or v_2 to obtain the error of the individual velocity components.
#
subsection K - ErrorEvaluation
  set trigger            = timer tick
  set trigger multiplier = 1
  set error quantities   = v_1, v_2
  set error normalize    = false
  set error norms        = Linf, L2
end
