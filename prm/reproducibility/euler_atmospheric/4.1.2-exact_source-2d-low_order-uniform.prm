##
#
# Exact solution with gravitational source, 2D, low-order method,
# Section 4.1.2 (Table 4.2a) of [1]:
#
#   rho = rho_0,  v = (0, v_0),
#   theta^gamma = -g (y - v_0 t) / (K rho_0^(gamma-1)),
#
# with rho_0 = v_0 = 1, g = 1, gamma = 1.4, zero integration constant, on
# D = [0,10] x [-11,-1] with Dirichlet boundary conditions, final time
# t = 1, CFL 0.5. The low-order method is obtained by disabling the
# limiter (iterations = 0). The table uses 10 x 10, 20 x 20, ..., 160 x 160
# cells (I = 121, ..., 25921; mesh refinement 0, ..., 4) and reports the
# sum of the normalized errors of rho, m_2, and rho_theta. c_v and p_0 only
# rescale theta and do not affect the normalized errors.
#
# [1] C. Farris, M. Maier, E. J. Tovar. Well-balanced second-order
#     approximation of the compressible atmospheric Euler equations.
#     arXiv:2606.19764, 2026.
#
##

subsection A - Scheduler
  set basename          = exact-source-2d-low-order-uniform
  set tasks             = error evaluation
  set final time        = 1
  set timer granularity = 1
  set align time steps  = true
end

subsection B - Equation
  set dimension          = 2
  set equation           = euler atmospheric
  set c_v                = 817
  set gamma              = 1.4
  set gravity            = 1
  set reference pressure = 100000
end

subsection C - Discretization
  set geometry        = rectangular domain
  set mesh refinement = 0
  set mesh distortion = 0

  subsection rectangular domain
    set position bottom left      = 0, -11
    set position top right        = 10, -1
    set subdivisions x            = 10
    set subdivisions y            = 10
    set boundary condition left   = dirichlet
    set boundary condition right  = dirichlet
    set boundary condition bottom = dirichlet
    set boundary condition top    = dirichlet
  end
end

subsection E - InitialValues
  set configuration = exact source
  set position      = 0, 0

  subsection exact source
    set reference density = 1
    set velocity          = 1
  end
end

subsection F - HyperbolicModule
  subsection limiter
    set iterations = 0
  end
end

subsection H - TimeIntegrator
  set cfl min = 0.5
  set cfl max = 0.5
end

subsection K - ErrorEvaluation
  set error quantities = rho, m_2, rho_theta
  set error normalize  = true
  set error norms      = Linf, L1
end
