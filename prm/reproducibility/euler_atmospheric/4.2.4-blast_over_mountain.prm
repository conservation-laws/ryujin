##
#
# Blast over a mountain, Section 4.2.4 (Figure 4.7) of [1]:
#
#   theta = 3000 inside the disc x^2 + (y - 4)^2 <= r^2, r = 0.75 km,
#   theta = 300  otherwise,  v = 0,
#
# on D = [-20,20] x [0,20] km^2 with the cosine shaped mountain
# y = 0.58 (1 + cos(pi x / 3.4)) for |x| <= 3.4 at the bottom, p_0 = 0.1,
# c_v = 717e-6, gamma = 1.4, g = 0.00981 (km units), slip boundary
# conditions on all sides, CFL 0.9, final time t = 30 s. The density is
# the isentropic (theta = 300) hydrostatic profile everywhere, also inside
# the disc, so that rho theta and p jump by factors 10 and 10^1.4 across
# the disc boundary.
#
# The triangular mesh (h = 0.1 km, 92943 vertices) is generated from
# 4.2.4-rectangle_mountain.geo:
#   gmsh -2 -format msh22 -o rectangle_mountain.msh 4.2.4-rectangle_mountain.geo
#
# [1] C. Farris, M. Maier, E. J. Tovar. Well-balanced second-order
#     approximation of the compressible atmospheric Euler equations.
#     arXiv:2606.19764, 2026.
#
##

subsection A - Scheduler
  set basename          = blast-over-mountain
  set tasks             = vtu output
  set final time        = 30
  set timer granularity = 0.1
end

subsection B - Equation
  set dimension          = 2
  set equation           = euler atmospheric
  set c_v                = 0.000717
  set gamma              = 1.4
  set gravity            = 0.00981
  set reference pressure = 0.1
end

subsection C - Discretization
  set geometry        = reader
  set mesh type       = parallel shared
  set mesh refinement = 0

  subsection reader
    set filename     = rectangle_mountain.msh
    set simplex mesh = true
  end
end

subsection E - InitialValues
  set configuration = stratified blast
  set position      = 0, 0

  subsection stratified blast
    set primitive state inner = 1, 0, 3000
    set primitive state outer = 1, 0, 300
    set radius                = 0.75
    set blast height          = 4
    set gravity               = 0.00981
  end
end

subsection H - TimeIntegrator
  set cfl min = 0.9
  set cfl max = 0.9
end

subsection I - VTUOutput
  subsection full
    set vtu output quantities = rho, theta
  end
end
