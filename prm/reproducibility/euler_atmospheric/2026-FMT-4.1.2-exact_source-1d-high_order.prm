##
#
# Exact solution with gravitational source, 1D, high-order method, Section
# 4.1.2 (Table 4.3) of [1]:
#
#   rho = rho_0,  v = v_0,
#   theta^gamma = -g (x - v_0 t) / (K rho_0^(gamma-1)),
#
# with rho_0 = v_0 = 1, g = 1, gamma = 1.4, zero integration constant, on
# D = [-11,-1] with Dirichlet boundary conditions, final time t = 5, CFL
# 0.5. Table 4.3 uses 100, 200, ..., 3200 subdivisions (mesh refinement 0,
# ..., 5).
#
# The pressure p = -g rho_0 (x - v_0 t) does not depend on c_v and p_0;
# changing them only rescales theta by a constant factor and leaves the
# normalized errors invariant.
#
# [1] C. Farris, M. Maier, E. J. Tovar. Well-balanced second-order
#     approximation of the compressible atmospheric Euler equations.
#     Preprint, 2026. arXiv:2606.19764
#
##

subsection A - Scheduler
  set basename          = exact-source-1d
  set tasks             = error evaluation
  set final time        = 5
  set timer granularity = 5
  set align time steps  = true
end

subsection B - Equation
  set dimension          = 1
  set equation           = euler atmospheric
  set c_v                = 817
  set gamma              = 1.4
  set gravity            = 1
  set reference pressure = 100000
end

subsection C - Discretization
  set geometry        = rectangular domain
  set mesh refinement = 0

  subsection rectangular domain
    set position bottom left     = -11
    set position top right       = -1
    set subdivisions x           = 100
    set boundary condition left  = dirichlet
    set boundary condition right = dirichlet
  end
end

subsection E - InitialValues
  set configuration = exact source
  set position      = 0

  subsection exact source
    set reference density = 1
    set velocity          = 1
  end
end

subsection F - HyperbolicModule
  set limit at dirichlet boundaries = false
end

subsection H - TimeIntegrator
  set cfl min = 0.5
  set cfl max = 0.5
end

subsection K - ErrorEvaluation
  set error quantities = rho, m, rho_theta
  set error normalize  = true
  set error norms      = Linf, L1, L2
end
