##
#
# Sod shock problem with gravity [1], Section 4.1.5 (Figure 4.3) of [2]:
#
#   (rho, v, theta) = (1, 0, 1)        for x < 0.5,
#   (rho, v, theta) = (0.125, 0, 1.54) for x >= 0.5,
#
# on D = [0,1] with p_0 = 1, c_v = 2.5, gamma = 1.4 (thus R = 1 and
# p = (rho theta)^gamma, i.e., p = 1 and 0.1 initially) and g = 1, slip
# boundary conditions, CFL 0.5. The solution is evaluated at t = 0.2 with
# 200 cells; the reference solution uses 3200 cells (mesh refinement 4).
#
# [1] K. Xu, J. Luo, S. Chen. A well-balanced kinetic scheme for gas dynamic
#     equations under gravitational field. Adv. Appl. Math. Mech.,
#     2(2):200-210, 2010. DOI 10.4208/aamm.09-m0964
#
# [2] C. Farris, M. Maier, E. J. Tovar. Well-balanced second-order
#     approximation of the compressible atmospheric Euler equations.
#     Preprint, 2026. arXiv:2606.19764
#
##

subsection A - Scheduler
  set basename          = sod-shock
  set tasks             = vtu output
  set final time        = 0.2
  set timer granularity = 0.002
end

subsection B - Equation
  set dimension          = 1
  set equation           = euler atmospheric
  set c_v                = 2.5
  set gamma              = 1.4
  set gravity            = 1
  set reference pressure = 1
end

subsection C - Discretization
  set geometry        = rectangular domain
  set mesh refinement = 0

  subsection rectangular domain
    set position bottom left     = 0
    set position top right       = 1
    set subdivisions x           = 200
    set boundary condition left  = slip
    set boundary condition right = slip
  end
end

subsection E - InitialValues
  set configuration = contrast
  set position      = 0.5

  subsection contrast
    set primitive state left  = 1, 0, 1
    set primitive state right = 0.125, 0, 1.54
  end
end

subsection H - TimeIntegrator
  set cfl min = 0.5
  set cfl max = 0.5
end

subsection I - VTUOutput
  subsection full
    set vtu output quantities = rho, v, p
  end
end
