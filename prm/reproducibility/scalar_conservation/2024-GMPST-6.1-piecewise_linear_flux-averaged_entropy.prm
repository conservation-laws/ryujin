##
#
# 1D Riemann problem with the piecewise linear flux f(u) = 2 - u for u <= 2
# and f(u) = 2u - 4 otherwise, Section 6.1 (Figure 2b) of [1].
#
# Same configuration as
# 2024-GMPST-6.1-piecewise_linear_flux-roe_average.prm but with the greedy
# wave speed augmented by an entropy inequality for the averaged Kruzkov
# entropy k = (u_i + u_j) / 2 per pair (i,j) ([1] uses k_i = (U_i^min +
# U_i^max) / 2 per grid point). This selects the entropy solution (6.1) of
# [1]: two contact waves moving with speed -1 and 2 separated by an
# expansion. SSPRK(3,3), CFL = 0.75, final time t = 0.5.
#
# The chosen 100 subdivisions with refinement 2 give 401 grid points.
#
# [1] J.-L. Guermond, M. Maier, B. Popov, L. Saavedra, I. Tomas. First-order
#     greedy invariant-domain preserving approximation for hyperbolic
#     problems: scalar conservation laws, and p-system. J. Sci. Comput.,
#     100(2):46, 2024. DOI 10.1007/s10915-024-02592-4, arXiv:2310.01713
#
##

subsection A - Scheduler
  set basename          = piecewise-linear-flux-averaged-entropy
  set align time steps  = true
  set tasks             = vtu output, error evaluation
  set final time        = 0.5
  set timer granularity = 0.05
end

subsection B - Equation
  set dimension = 1
  set equation  = scalar conservation
  set flux      = function

  subsection function
    set expression = if(u <= 2, 2 - u, 2 * u - 4)
  end
end

subsection C - Discretization
  set geometry        = rectangular domain
  set mesh refinement = 2

  subsection rectangular domain
    set position bottom left     = -2
    set position top right       = 2
    set subdivisions x           = 100
    set boundary condition left  = dirichlet
    set boundary condition right = dirichlet
  end
end

subsection E - InitialValues
  set configuration = function
  set direction     = 1
  set position      = 0

  subsection function
    # exact solution (6.1) of [1]
    set expression = if(x <= -t, 1, if(x <= 2 * t, 2, 3))
  end
end

subsection F - HyperbolicModule
  subsection limiter
    set iterations = 0
  end

  subsection wave speed estimator
    set use greedy wavespeed = true
    set use averaged entropy = true
    set random entropies     = 0
  end
end

subsection H - TimeIntegrator
  set cfl min               = 0.75
  set cfl max               = 0.75
  set cfl recovery strategy = none
  set time stepping scheme  = ssprk 33
end

subsection I - VTUOutput
  subsection full
    set vtu output quantities = u
  end
end

subsection K - ErrorEvaluation
  set error normalize  = true
  set error norms      = L1, L2
  set error quantities = u
end
