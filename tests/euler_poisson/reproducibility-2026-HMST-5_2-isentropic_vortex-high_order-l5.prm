##
#
# Reproducibility test for
#   prm/reproducibility/euler_poisson/2026-HMST-5.2-isentropic_vortex-high_order.prm
# at mesh refinement 5 (4096 dofs). Table 5.1b of [2026-HMST] reports
# delta_h = 3.827e-1 for this mesh.
#
##

subsection A - Scheduler
  set basename          = isentropic_vortex-high_order
  set tasks             = error evaluation

  set final time        = 1.0
  set timer granularity = 1.0
  set align time steps  = true
end


subsection B - Equation
  set dimension                   = 2
  set equation                    = euler poisson
  set gamma                       = 1.666666666666667

  set alpha                       = 1
  set electrostatic configuration = function

  subsection function
    set time dependent     = true
    set magnetic field z   = 0.

    #
    # rho_b = -T^(1 / (gamma - 1)),
    # T     = 1 - (gamma - 1) / (2 gamma) f^2,
    # f     = beta / (2 pi) exp(0.5 (1 - |r|^2)),
    # r     = (x, y) - (x_0, y_0) - (1, 1) t
    #
    set background density = -pow(1. - (5./3. - 1.) / (2. * 5./3.) * pow(5. / (2. * 3.1415926535897932) * exp(0.5 * (1. - pow(x + 1. - t, 2.) - pow(y + 1. - t, 2.))), 2.), 1. / (5./3. - 1.))
  end
end


subsection C - Discretization
  set finite element ansatz = dG Q1

  set geometry              = rectangular domain
  set mesh refinement       = 5

  subsection rectangular domain
    set position bottom left      = -5, -5
    set position top right        =  5,  5

    set boundary condition bottom = dirichlet
    set boundary condition left   = dirichlet
    set boundary condition right  = dirichlet
    set boundary condition top    = dirichlet
  end
end


subsection E - InitialValues
  set configuration = isentropic vortex
  set direction     =  1,  1
  set position      = -1, -1

  subsection isentropic vortex
    set mach number = 1.414213562373095
    set beta        = 5
  end
end


subsection F - HyperbolicModule
  set limit at dirichlet boundaries = false

  subsection indicator
    set evc factor = 0.1
  end
end


subsection G - ParabolicModule
  set gauss law restart strategy = no restart
  set tolerance                  = 1e-12
end


subsection H - TimeIntegrator
  set cfl min               = 0.1
  set cfl max               = 0.1
  set cfl recovery strategy = none
  set time stepping scheme  = strang erk 33 cn
end


subsection K - ErrorEvaluation
  set error normalize  = false
  set error quantities = rho, m_1, m_2, E
end


subsection M - Logger
  set terminal update interval = 0
end
