#pragma once

/* Compile-time options: */

#define NUMBER @NUMBER@

/* Debug options: */

#cmakedefine DEBUG_OUTPUT
#cmakedefine DEBUG_EXPENSIVE_BOUNDS_CHECK
#cmakedefine DEBUG_SYMMETRY_CHECK

/* Compile-time parameters: */

#cmakedefine ASYNC_MPI_EXCHANGE
#cmakedefine DENORMALS_ARE_ZERO
#cmakedefine FORCE_DEAL_II_SPARSE_MATRIX

/* External packages: */

#cmakedefine WITH_EOSPAC
#cmakedefine WITH_GDAL
#cmakedefine WITH_LIKWID
#cmakedefine WITH_OPENMP
#cmakedefine WITH_VALGRIND

/* Workarounds: */

/*
 * Works around an issue when compiling ryujin with clang and attempting to
 * link against a deal.II library compiled with gcc. Both compilers seem to
 * disagree on how to name mangle the symbol leading to an undefined
 * reference when trying to link the final executable.
 */
#cmakedefine BUG_COLLECT_PERIODIC_FACES_INSTANTIATION

/*
 * This is an evil hack: enforce that we can provide our own
 * Patterns::Tools::Convert specialization by undefining the
 * DEAL_II_WITH_MAGIC_ENUM preprocessor definition
 */
#include <deal.II/base/config.h>
#ifdef DEAL_II_WITH_MAGIC_ENUM
#undef DEAL_II_WITH_MAGIC_ENUM
#endif
